# ---- Required ----

# Postgres connection string (use postgresql:// or postgres://)
DATABASE_URL="postgresql://user:password@localhost:5432/noida_villa?schema=public"

# Auth.js secret — REQUIRED. Generate with: openssl rand -base64 32
# The application refuses to start in production if this is missing.
AUTH_SECRET="replace-me-with-a-strong-32-byte-secret"

# Public site URL (used for canonical links, OG, sitemap, CSRF origin checks). NO trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Set NODE_ENV in production. Used to enforce security defaults.
NODE_ENV="development"

# ---- Property configuration (initial seed / fallback values) ----
# After first launch, edit these in the admin CMS at /admin/property.
# The DB is the runtime source of truth; env vars are only used to seed initial content.

NEXT_PUBLIC_PROPERTY_NAME="The Noida Villa"
NEXT_PUBLIC_PROPERTY_TAGLINE="A private escape in the heart of Noida"
NEXT_PUBLIC_PROPERTY_CITY="Noida"
NEXT_PUBLIC_PROPERTY_STATE="Uttar Pradesh"
NEXT_PUBLIC_PROPERTY_COUNTRY="India"

# Initial Airbnb URL — empty until listing goes live. Edit later in /admin/property.
NEXT_PUBLIC_AIRBNB_URL=""

# Contact
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_CONTACT_PHONE="+91-0000000000"
NEXT_PUBLIC_CONTACT_WHATSAPP=""

# Social
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""

# ---- Analytics (optional) ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""

# ---- Storage ----
# Where receipt files are written on disk (relative paths used in DB).
# Files are served via /api/files/[id] which requires authenticated membership.
STORAGE_ROOT="./storage"

# ---- Seed admin (only used by `npm run db:seed`) ----
# In production, BOTH must be set explicitly. The seed refuses weak passwords (<12 chars,
# no upper/lower/digit, common dictionary). The password is NEVER echoed to stdout in
# production mode.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2024"
SEED_ADMIN_NAME="Property Admin"

# ---- Demo / Staging ----
# Set to "1" to display the subtle "Preview — staging environment" footer
# indicator on the public site. The admin header also shows "Demo Workspace"
# whenever the demo property is the active workspace. Recommended for demo
# deployments; should be unset in real production.
NEXT_PUBLIC_DEMO=""

# ---- Demo password overrides (used by `npm run db:seed:demo`) ----
# In dev, defaults are DemoAdmin!2024 / DemoOwner!2024.
# In production, you MUST set these to strong passwords (≥12 chars, mixed).
DEMO_ADMIN_PASSWORD=""
DEMO_OWNER_PASSWORD=""
